#!/bin/sh
# fileinfo — show type, permissions, size, owner and mtime for files.
# POSIX sh / BusyBox compatible; no external binaries beyond coreutils/BusyBox.

VERSION="1.0"

usage() {
    cat <<'EOF'
fileinfo - show file metadata

Usage:
  fileinfo FILE [FILE...]

Examples:
  fileinfo /usr/data/hello
  fileinfo /etc/passwd /tmp
EOF
}

if [ "$#" -eq 0 ]; then
    usage
    exit 1
fi

case "$1" in
    -h|--help)
        usage
        exit 0
        ;;
esac

get_mtime() {
    # Prefer stat -c %y (GNU/BusyBox). Fall back to ls -ld date fields.
    if command -v stat >/dev/null 2>&1; then
        stat -c '%y' "$1" 2>/dev/null | sed 's/\..*//'
    fi
}

for path in "$@"; do
    if [ ! -e "$path" ] && [ ! -L "$path" ]; then
        printf 'fileinfo: %s: No such file or directory\n' "$path" >&2
        continue
    fi

    line=$(ls -ld "$path" 2>/dev/null)
    if [ -z "$line" ]; then
        printf 'fileinfo: %s: cannot read metadata\n' "$path" >&2
        continue
    fi

    mode=$(printf '%s\n' "$line" | awk '{print $1}')
    links=$(printf '%s\n' "$line" | awk '{print $2}')
    owner=$(printf '%s\n' "$line" | awk '{print $3}')
    group=$(printf '%s\n' "$line" | awk '{print $4}')
    ls_size=$(printf '%s\n' "$line" | awk '{print $5}')

    if [ -L "$path" ]; then
        type="symbolic link -> $(readlink "$path" 2>/dev/null)"
        size="$ls_size bytes (link)"
    elif [ -d "$path" ]; then
        type="directory"
        size="$ls_size bytes (directory entry)"
    elif [ -f "$path" ]; then
        type="regular file"
        bytes=$(wc -c < "$path" 2>/dev/null | awk '{print $1}')
        size="${bytes:-$ls_size} bytes"
    elif [ -c "$path" ]; then
        type="character device"
        size="$ls_size bytes (device)"
    elif [ -b "$path" ]; then
        type="block device"
        size="$ls_size bytes (device)"
    elif [ -p "$path" ]; then
        type="FIFO"
        size="$ls_size bytes"
    elif [ -S "$path" ]; then
        type="socket"
        size="$ls_size bytes"
    else
        type="unknown"
        size="$ls_size bytes"
    fi

    modified=$(get_mtime "$path")
    if [ -z "$modified" ]; then
        prefix=${line%$path}
        modified=$(printf '%s\n' "$prefix" | awk '{for (i=6; i<=NF; i++) printf "%s%s", $i, (i<NF ? " " : "")}')
    fi

    printf 'Path:     %s\n' "$path"
    printf 'Type:     %s\n' "$type"
    printf 'Size:     %s\n' "$size"
    printf 'Mode:     %s\n' "$mode"
    printf 'Links:    %s\n' "$links"
    printf 'Owner:    %s\n' "$owner"
    printf 'Group:    %s\n' "$group"
    printf 'Modified: %s\n' "$modified"
    printf '\n'
done
