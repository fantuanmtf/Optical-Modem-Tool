#!/bin/sh
# zxtools - small shell toolbox for rooted ZTE/ZXIC optical modems.
# POSIX sh / BusyBox ash compatible. No external dependencies beyond BusyBox.

VERSION="1.0"

case "$0" in
    */*) self="$0" ;;
    *)   self=$(command -v "$0" 2>/dev/null || printf '%s' "$0") ;;
esac
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$self")" 2>/dev/null && pwd)

usage() {
    cat <<EOF
zxtools $VERSION - optical modem shell toolbox

Usage:
  zxtools                         interactive menu
  zxtools router-check [options]  system / memory / storage / network report
  zxtools fileinfo PATH...        file type, size, mode, owner, mtime
  zxtools netmon [options]        realtime RX/TX monitor (alias: zxnetmon)
  zxtools help                    this help

Examples:
  zxtools
  zxtools router-check
  zxtools router-check --save
  zxtools fileinfo /usr/data/hello
  zxtools netmon -i br0 -n 1

The interactive menu needs a terminal. Over non-PTY SSH use a subcommand:
  ssh -T root@192.168.1.1 'zxtools router-check'
For a full terminal use Telnet.
EOF
}

run_tool() {
    name="$1"
    shift
    if [ -x "$SELF_DIR/$name" ]; then
        "$SELF_DIR/$name" "$@"
        return $?
    fi
    if command -v "$name" >/dev/null 2>&1; then
        "$name" "$@"
        return $?
    fi
    printf 'zxtools: %s not found (looked in %s and PATH)\n' "$name" "$SELF_DIR" >&2
    return 127
}

clear_screen() {
    printf '\033[H\033[2J'
}

pause() {
    printf '\nPress Enter to return...'
    IFS= read -r _ || true
}

menu() {
    if [ ! -t 0 ]; then
        usage
        return 0
    fi

    while :; do
        clear_screen
        cat <<EOF
========================================
              ZXTOOLS $VERSION
========================================

  1) router-check    system / memory / disk / network
  2) fileinfo        file details
  3) zxnetmon        realtime traffic
  4) router-check    save a report

  q) quit

========================================
EOF
        printf 'Select [1-4, q]: '
        IFS= read -r choice || break
        case "$choice" in
            1) run_tool router-check ;;
            2)
                printf 'Path: '
                IFS= read -r path || break
                if [ -n "$path" ]; then
                    run_tool fileinfo "$path"
                else
                    printf 'No path entered.\n'
                fi
                ;;
            3) run_tool zxnetmon ;;
            4) run_tool router-check --save ;;
            q|Q) break ;;
            *) printf 'Unknown choice: %s\n' "$choice" ;;
        esac
        pause
    done
    clear_screen
}

case "${1:-}" in
    "")            menu ;;
    help|-h|--help) usage ;;
    router-check|check)
        shift
        run_tool router-check "$@"
        ;;
    fileinfo|info)
        shift
        run_tool fileinfo "$@"
        ;;
    netmon|zxnetmon|monitor)
        shift
        run_tool zxnetmon "$@"
        ;;
    *)
        printf 'zxtools: unknown command: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac
