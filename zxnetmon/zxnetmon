#!/bin/sh
# zxnetmon - small BusyBox-friendly realtime network monitor
# Reads /proc/net/dev; no external dependencies beyond awk/sleep.

LC_ALL=C
export LC_ALL

VERSION="1.0"
IFACE="br0"
INTERVAL=1
HISTORY_LEN=30
ROWS=5

usage() {
    cat <<EOF
zxnetmon $VERSION - realtime network traffic monitor

Usage:
  zxnetmon [-i IFACE] [-n SECONDS]

Options:
  -i IFACE   interface to monitor (default: br0)
  -n SECONDS sample interval (default: 1)
  -h         show this help

Reads counters from /proc/net/dev. Press Ctrl+C to exit.
On this modem's SSH server, use Telnet for a full interactive terminal.
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        -i|--interface)
            [ $# -ge 2 ] || { echo "zxnetmon: -i needs an interface" >&2; exit 2; }
            IFACE="$2"
            shift 2
            ;;
        -n|--interval)
            [ $# -ge 2 ] || { echo "zxnetmon: -n needs a number" >&2; exit 2; }
            INTERVAL="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "zxnetmon: unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

case "$INTERVAL" in
    ''|*[!0-9]*)
        echo "zxnetmon: interval must be a positive integer" >&2
        exit 2
        ;;
esac
[ "$INTERVAL" -ge 1 ] 2>/dev/null || {
    echo "zxnetmon: interval must be >= 1" >&2
    exit 2
}

NETDEV=/proc/net/dev
[ -r "$NETDEV" ] || { echo "zxnetmon: cannot read $NETDEV" >&2; exit 1; }

list_interfaces() {
    awk -F: '
        /:/ {
            name=$1
            gsub(/^[ \t]+|[ \t]+$/, "", name)
            if (name != "" && name != "Inter-|" && name != " face")
                print "  " name
        }
    ' "$NETDEV"
}

read_counters() {
    set -- $(awk -v iface="$IFACE" '
        $0 ~ ("^[[:space:]]*" iface ":") {
            sub(":", "", $1)
            print $2, $10
            found = 1
        }
        END { if (!found) exit 1 }
    ' "$NETDEV")
    [ $# -eq 2 ] || return 1
    CUR_RX=$1
    CUR_TX=$2
}

read_counters || {
    echo "zxnetmon: interface '$IFACE' not found." >&2
    echo "Available interfaces:" >&2
    list_interfaces >&2
    exit 1
}

human_bytes() {
    awk -v n="$1" 'BEGIN {
        split("B KB MB GB TB", u, " ")
        i = 1
        while (n >= 1024 && i < 5) { n /= 1024; i++ }
        printf "%.2f %s", n, u[i]
    }'
}

human_rate() {
    printf '%s/s' "$(human_bytes "$1")"
}

compute_rates() {
    awk -v a="$PREV_RX" -v b="$CUR_RX" \
        -v c="$PREV_TX" -v d="$CUR_TX" -v iv="$INTERVAL" '
        BEGIN {
            dr = b - a
            dt = d - c
            if (dr < 0) dr = 0
            if (dt < 0) dt = 0
            printf "%.0f %.0f", dr / iv, dt / iv
        }'
}

HIST_RX=""
HIST_TX=""
i=0
while [ "$i" -lt "$HISTORY_LEN" ]; do
    HIST_RX="$HIST_RX 0"
    HIST_TX="$HIST_TX 0"
    i=$((i + 1))
done

add_history() {
    new_rx="$1"
    new_tx="$2"
    set -- $HIST_RX "$new_rx"
    if [ "$#" -gt "$HISTORY_LEN" ]; then
        shift $(( $# - HISTORY_LEN ))
    fi
    HIST_RX="$*"

    set -- $HIST_TX "$new_tx"
    if [ "$#" -gt "$HISTORY_LEN" ]; then
        shift $(( $# - HISTORY_LEN ))
    fi
    HIST_TX="$*"
}

max_rate() {
    awk -v rx="$HIST_RX" -v tx="$HIST_TX" 'BEGIN {
        nr = split(rx, a, " ")
        nt = split(tx, b, " ")
        m = 1
        for (i = 1; i <= nr; i++) if (a[i] > m) m = a[i]
        for (i = 1; i <= nt; i++) if (b[i] > m) m = b[i]
        printf "%.0f", m
    }'
}

render_graph() {
    awk -v rx="$HIST_RX" -v tx="$HIST_TX" -v max="$MAX_RATE" \
        -v rows="$ROWS" -v cols="$HISTORY_LEN" '
        function human(n,  u, i) {
            split("B KB MB GB TB", u, " ")
            i = 1
            while (n >= 1024 && i < 5) { n /= 1024; i++ }
            return sprintf("%.1f %s", n, u[i])
        }
        BEGIN {
            split(rx, a, " ")
            split(tx, b, " ")
            for (r = rows; r >= 1; r--) {
                printf "%10s |", human(max * r / rows)
                for (i = 1; i <= cols; i++) {
                    rh = (a[i] * rows / max) + 0.5
                    th = (b[i] * rows / max) + 0.5
                    if (rh >= r && th >= r) c = "#"
                    else if (rh >= r) c = "*"
                    else if (th >= r) c = "+"
                    else c = " "
                    printf "%s", c
                }
                printf "\n"
            }
            printf "%10s +", "0.0 B/s"
            for (i = 1; i <= cols; i++) printf "-"
            printf "\n"
        }'
}

cleanup() {
    printf '\033[?25h'
}

trap 'cleanup; printf "\n"; exit 0' INT TERM
trap 'cleanup' EXIT

PREV_RX="$CUR_RX"
PREV_TX="$CUR_TX"
MAX_RATE=1

render() {
    printf '\033[H\033[2J'
    printf '========================================\n'
    printf '          ZX NETMONITOR v%s\n' "$VERSION"
    printf '========================================\n\n'
    printf 'Interface: %s\n\n' "$IFACE"
    printf 'Download:   %s\n' "$(human_rate "$RATE_RX")"
    printf 'Upload:     %s\n\n' "$(human_rate "$RATE_TX")"
    printf 'RX Total:   %s\n' "$(human_bytes "$CUR_RX")"
    printf 'TX Total:   %s\n\n' "$(human_bytes "$CUR_TX")"
    printf '%s\n' '----------------------------------------'
    printf '        REALTIME TRAFFIC (last %s sec)\n' "$HISTORY_LEN"
    printf '%s\n' '----------------------------------------'
    render_graph
    printf '\nLegend: * RX   + TX   # both\n'
    printf 'Press Ctrl+C to exit\n'
}

RATE_RX=0
RATE_TX=0
printf '\033[?25l'
render

while :; do
    sleep "$INTERVAL"
    read_counters || {
        cleanup
        printf '\n'
        echo "zxnetmon: interface '$IFACE' disappeared" >&2
        exit 1
    }
    rates=$(compute_rates)
    set -- $rates
    RATE_RX="$1"
    RATE_TX="$2"
    add_history "$RATE_RX" "$RATE_TX"
    MAX_RATE=$(max_rate)
    render
    PREV_RX="$CUR_RX"
    PREV_TX="$CUR_TX"
done
