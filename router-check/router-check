#!/bin/sh
# router-check - read-only health report for BusyBox optical modems.
# Pure POSIX sh; no compiled helpers.

VERSION=1.0
OUT=""
SAVE=0

usage() {
    cat <<'EOF'
Usage: router-check [-o FILE | --save]

Read-only system report: kernel, CPU, memory, storage, interfaces,
routes, listening sockets, ARP table and processes.

Options:
  -o, --output FILE   Write the report to FILE as well as stdout.
      --save          Save under /usr/data/zxtools/reports/.
  -h, --help          Show this help.
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -o|--output)
            if [ "$#" -lt 2 ]; then
                echo "router-check: missing argument for $1" >&2
                exit 2
            fi
            OUT=$2
            shift 2
            ;;
        --save)
            SAVE=1
            shift
            ;;
        *)
            echo "router-check: unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [ "$SAVE" -eq 1 ] && [ -z "$OUT" ]; then
    OUT="/usr/data/zxtools/reports/router-check-$(date +%Y%m%d-%H%M%S).txt"
fi

if [ -n "$OUT" ]; then
    mkdir -p "$(dirname "$OUT")" 2>/dev/null || true
    : > "$OUT" || {
        echo "router-check: cannot write $OUT" >&2
        exit 1
    }
fi

emit() {
    printf '%s\n' "$*"
    [ -n "$OUT" ] && printf '%s\n' "$*" >> "$OUT"
}

emit_text() {
    if [ -n "$OUT" ]; then
        tee -a "$OUT"
    else
        cat
    fi
}

section() {
    emit ""
    emit "== $1 =="
}

have() {
    command -v "$1" >/dev/null 2>&1
}

emit "Optical-Modem-Tool / router-check v$VERSION"
emit "Generated: $(date 2>/dev/null)"
emit "Host: $(hostname 2>/dev/null)"

section "System"
if have uname; then
    uname -a 2>&1 | emit_text
fi
if have uptime; then
    uptime 2>/dev/null | emit_text
fi
if [ -r /proc/loadavg ]; then
    emit "Load: $(cat /proc/loadavg 2>/dev/null)"
fi
if [ -r /etc/openwrt_release ]; then
    emit ""
    cat /etc/openwrt_release 2>/dev/null | emit_text
fi

section "CPU"
if [ -r /proc/cpuinfo ]; then
    awk -F: '/^(processor|model name|Processor|Hardware|Revision|BogoMIPS)/ {
        key=$1; val=$2;
        gsub(/^[ \t]+|[ \t]+$/, "", key);
        gsub(/^[ \t]+|[ \t]+$/, "", val);
        print key ": " val;
    }' /proc/cpuinfo | head -20 | emit_text
else
    emit "no /proc/cpuinfo"
fi

section "Memory"
if [ -r /proc/meminfo ]; then
    awk '/^(MemTotal|MemFree|MemAvailable|Buffers|Cached|SwapTotal|SwapFree):/ {
        printf "%-12s %s %s\n", $1, $2, $3;
    }' /proc/meminfo | emit_text
    awk '/^MemTotal:/ {t=$2}
         /^MemAvailable:/ {a=$2}
         /^MemFree:/ {f=$2}
         END {
             if (a == "") a=f;
             if (t > 0) printf "Used (approx): %.1f%%\n", (t-a)*100/t;
         }' /proc/meminfo | emit_text
else
    emit "no /proc/meminfo"
fi

section "Storage"
if have df; then
    if df -h >/dev/null 2>&1; then
        df -h 2>&1 | emit_text
    else
        df -k 2>&1 | emit_text
    fi
else
    emit "df not available"
fi

section "Network interfaces"
if have ifconfig; then
    ifconfig -a 2>&1 | emit_text
elif have ip; then
    ip addr 2>&1 | emit_text
else
    emit "neither ifconfig nor ip found"
fi

if have route; then
    emit ""
    emit "-- routes --"
    route -n 2>&1 | emit_text
fi

if [ -r /proc/net/dev ]; then
    emit ""
    emit "-- /proc/net/dev --"
    cat /proc/net/dev 2>/dev/null | emit_text
fi

if have netstat; then
    emit ""
    emit "-- listening sockets --"
    netstat -lntp 2>/dev/null | emit_text || netstat -ln 2>/dev/null | emit_text
fi

if have brctl; then
    emit ""
    emit "-- bridge --"
    brctl show 2>&1 | emit_text
fi

section "ARP"
if [ -r /proc/net/arp ]; then
    cat /proc/net/arp 2>/dev/null | emit_text
else
    emit "no /proc/net/arp"
fi

section "Processes"
if have ps; then
    ps 2>&1 | emit_text
else
    emit "ps not available"
fi

section "Wireless"
if have iwconfig; then
    iwconfig 2>/dev/null | emit_text
else
    emit "iwconfig not available"
fi

emit ""
emit "Report complete."
if [ -n "$OUT" ]; then
    emit "Saved: $OUT"
fi
